{% extends 'base.html.twig' %}

{% import '_macros.html.twig' as ui %}

{% block title %}{{ 'profile.confirm_title'|trans }}{% endblock %}

{% block breadcrumbs %}
    {{ ui.breadcrumbs([
        {label: 'nav.profile'|trans, url: path('app_profile')},
        {label: 'profile.confirm_title'|trans},
    ]) }}
{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ 'profile.confirm_title'|trans }}</h1>
            <p class="sub">{{ 'profile.confirm_intro'|trans }}</p>
        </div>
        {{ include('profile/_nav.html.twig') }}
    </div>

    <div class="card">
        {% if error %}
            <ul class="errors"><li>{{ error|trans }}</li></ul>
        {% endif %}
        {{ include('profile/_confirm_form.html.twig', {target: target}) }}
    </div>
{% endblock %}