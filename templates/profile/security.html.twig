{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.tab_security'|trans }}{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ 'profile.tab_security'|trans }}</h1>
            <p class="sub">{{ 'profile.security_intro'|trans }}</p>
        </div>
        {{ include('profile/_nav.html.twig') }}
    </div>

    <div class="stack">
        {% if backup_codes %}
            <div class="card">
                <h2>{{ 'totp.backup_codes'|trans }}</h2>
                <p>{{ 'totp.backup_codes_once'|trans }}</p>
                <ul class="codes">
                    {% for code in backup_codes %}<li>{{ code }}</li>{% endfor %}
                </ul>
                <button type="button" class="btn btn-sm" data-copy="{{ backup_codes|join('\n') }}" data-copied-label="{{ 'action.copied'|trans }}">{{ 'action.copy'|trans }}</button>
            </div>
        {% endif %}

        <div class="card">
            <div class="card-head">
                <h2>{{ 'passkey.title'|trans }}</h2>
                <button type="button" class="btn btn-primary"
                        data-passkey="register"
                        data-options-url="{{ path('webauthn.controller.creation.request.profile_passkey') }}"
                        data-result-url="{{ path('webauthn.controller.creation.response.profile_passkey') }}"
                        data-error-message="{{ 'passkey.register_failed'|trans }}"
                        data-aborted-message="{{ 'passkey.aborted'|trans }}">
                    + {{ 'passkey.add'|trans }}
                </button>
            </div>
            <p class="muted small">{{ 'passkey.intro'|trans }}</p>
            <p id="passkey-error" class="errors" hidden></p>
            <p id="passkey-unsupported" class="small muted" hidden>{{ 'passkey.unsupported'|trans }}</p>
            {% if passkeys is empty %}
                <p class="muted">{{ 'passkey.none'|trans }}</p>
            {% else %}
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>{{ 'passkey.name'|trans }}</th><th class="hide-sm">{{ 'passkey.created'|trans }}</th><th class="hide-sm">{{ 'passkey.last_used'|trans }}</th><th></th></tr></thead>
                        <tbody>
                            {% for passkey in passkeys %}
                                <tr>
                                    <td>
                                        <form method="post" action="{{ path('app_profile_passkey_rename', {id: passkey.id}) }}" class="copy-field">
                                            <input type="text" name="name" value="{{ passkey.name }}" maxlength="100" aria-label="{{ 'passkey.name'|trans }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('passkey-rename-' ~ passkey.id) }}">
                                            <button class="btn btn-sm">{{ 'action.save'|trans }}</button>
                                        </form>
                                        {% if passkey.synced %}<span class="badge">{{ 'passkey.synced'|trans }}</span>{% endif %}
                                    </td>
                                    <td class="hide-sm small muted">{{ passkey.createdAt|date('d.m.Y') }}</td>
                                    <td class="hide-sm small muted">{{ passkey.lastUsedAt ? passkey.lastUsedAt|date('d.m.Y H:i') : '–' }}</td>
                                    <td>
                                        <form method="post" action="{{ path('app_profile_passkey_delete', {id: passkey.id}) }}" data-confirm="{{ 'passkey.delete_confirm'|trans }}" class="inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('passkey-delete-' ~ passkey.id) }}">
                                            <button class="btn btn-sm btn-danger">{{ 'action.delete'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <div class="card">
            <div class="card-head">
                <h2>{{ 'totp.title'|trans }}</h2>
                {% if app.user.totpAuthenticationEnabled %}
                    <span class="badge badge-success">{{ 'totp.on'|trans }}</span>
                {% else %}
                    <span class="badge">{{ 'totp.off'|trans }}</span>
                {% endif %}
            </div>
            <p class="muted small">{{ 'totp.intro'|trans }}</p>
            {% if app.user.totpAuthenticationEnabled %}
                <p class="small">{{ 'totp.codes_left'|trans({'%count%': app.user.countBackupCodes}) }}</p>
                <div class="actions">
                    <form method="post" action="{{ path('app_profile_totp_backup_codes') }}" class="inline-form" data-confirm="{{ 'totp.new_codes_confirm'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('backup-codes') }}">
                        <button class="btn">{{ 'totp.new_codes'|trans }}</button>
                    </form>
                    <form method="post" action="{{ path('app_profile_totp_disable') }}" class="inline-form" data-confirm="{{ 'totp.disable_confirm'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('totp-disable') }}">
                        <button class="btn btn-danger">{{ 'totp.disable'|trans }}</button>
                    </form>
                </div>
            {% else %}
                <a class="btn btn-primary" href="{{ path('app_profile_totp_setup') }}">{{ 'totp.enable'|trans }}</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
