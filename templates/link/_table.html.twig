{% if links|length == 0 %}
    <div class="empty">
        <p>{{ 'links.empty'|trans }}</p>
    </div>
{% else %}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>{{ 'links.col.link'|trans }}</th>
                    {% if show_owner %}<th class="hide-sm">{{ 'links.col.owner'|trans }}</th>{% endif %}
                    <th class="num">{{ 'links.col.clicks'|trans }}</th>
                    <th class="hide-sm">{{ 'links.col.created'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for link in links %}
                    <tr>
                        <td class="link-cell">
                            <a class="short truncate" href="{{ path('app_link_show', {id: link.id}) }}">{{ link.domain.displayName }}/{{ link.code }}</a>
                            <span class="target truncate" title="{{ link.targetUrl }}">{{ link.title ?? link.targetUrl }}</span>
                            {% if not link.active %}<span class="badge badge-warning">{{ 'link.inactive'|trans }}</span>{% endif %}
                            {% if link.expired %}<span class="badge badge-danger">{{ 'link.expired'|trans }}</span>{% endif %}
                            {% if link.localisations|length > 0 %}<span class="badge">{{ link.localisations|map(l => l.language)|join(' · ') }}</span>{% endif %}
                        </td>
                        {% if show_owner %}<td class="hide-sm small">{{ link.owner.displayName }}</td>{% endif %}
                        <td class="num">{{ link.clickCount|number_format(0, ',', '.') }}</td>
                        <td class="hide-sm small muted nowrap">{{ link.createdAt|date('d.m.Y') }}</td>
                        <td class="nowrap">
                            <button type="button" class="btn btn-sm" data-copy="{{ link.shortUrl }}" data-copied-label="{{ 'action.copied'|trans }}">{{ 'action.copy'|trans }}</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
