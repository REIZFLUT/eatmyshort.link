<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}{% endblock %}{% if block('title') is not empty %} · {% endif %}{{ app_title() }}</title>
    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ path('app_branding_css') }}">
    {% block importmap %}{{ importmap('app', {nonce: csp_nonce()}) }}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
{% block body %}
    {% set route = app.request.attributes.get('_route') ?? '' %}
    <header class="topbar">
        <div class="container">
            <a class="brand" href="{{ path('app_dashboard') }}" title="{{ app_title() }}">
                {% if has_custom_logo() %}
                    <img src="{{ path('app_branding_logo') }}" alt="{{ app_title() }}">
                {% else %}
                    {{ include('_logo.svg.twig') }}
                {% endif %}
            </a>
            <nav class="nav" aria-label="{{ 'nav.main'|trans }}">
                <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}">{{ 'nav.dashboard'|trans }}</a>
                <a href="{{ path('app_links') }}" class="{{ route starts with 'app_link' ? 'active' }}">{{ 'nav.links'|trans }}</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="sep" aria-hidden="true"></span>
                    <a href="{{ path('app_admin_users') }}" class="{{ route starts with 'app_admin_user' ? 'active' }}">{{ 'nav.users'|trans }}</a>
                    <a href="{{ path('app_admin_domains') }}" class="{{ route starts with 'app_admin_domain' ? 'active' }}">{{ 'nav.domains'|trans }}</a>
                    <a href="{{ path('app_admin_stats') }}" class="{{ route == 'app_admin_stats' ? 'active' }}">{{ 'nav.stats'|trans }}</a>
                    <a href="{{ path('app_admin_ip_rules') }}" class="{{ route starts with 'app_admin_ip' ? 'active' }}">{{ 'nav.ip_rules'|trans }}</a>
                    <a href="{{ path('app_admin_settings') }}" class="{{ route == 'app_admin_settings' ? 'active' }}">{{ 'nav.settings'|trans }}</a>
                {% endif %}
            </nav>
            <div class="usermenu">
                <a href="{{ path('app_profile') }}" class="{{ route starts with 'app_profile' ? 'active' }}" title="{{ 'nav.profile'|trans }}">{{ app.user.displayName }}</a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm">{{ 'nav.logout'|trans }}</a>
            </div>
        </div>
    </header>

    <main>
        <div class="container">
            {{ include('_partials/flashes.html.twig') }}
            {% block content %}{% endblock %}
        </div>
    </main>

    <footer class="site">
        <div class="container">
            <span>{{ app_title() }}</span>
            <span>EatMyShort.Link · GPL-3.0</span>
        </div>
    </footer>
{% endblock %}
</body>
</html>
