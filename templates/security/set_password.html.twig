{% extends 'minimal.html.twig' %}

{% block title %}{{ ('set_password.title_' ~ purpose)|trans }}{% endblock %}

{% block content %}
    <div class="card">
        <h1>{{ ('set_password.title_' ~ purpose)|trans }}</h1>
        <p class="muted">{{ ('set_password.text_' ~ purpose)|trans({'%name%': user.displayName, '%email%': user.email}) }}</p>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary btn-block">{{ 'set_password.submit'|trans }}</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
