APP_ENV=prod
APP_SECRET=bitte-durch-32-zufaellige-zeichen-ersetzen
APP_ADMIN_HOSTS=links.firma.de
DEFAULT_URI=https://links.firma.de
MAILER_DSN=smtp://user:passwort@smtp.firma.de:587
MAILER_FROM="Kurzlinks Firma <noreply@firma.de>"
ADMIN_IP_ALLOWLIST=
# Nur die IPs der eigenen Reverse-Proxys eintragen (z. B. 10.0.0.5,10.0.0.6). Leer = keine Proxys.
# REMOTE_ADDR ist hier falsch: Die App wuerde dann jedem Client-Header glauben und die
# IP-Sperre von /admin waere mit einem gefaelschten X-Forwarded-For umgehbar.
TRUSTED_PROXIES=
APP_TIMEZONE=Europe/Berlin
GEOIP_DATABASE_PATH=
CLICK_RETENTION_DAYS=730
