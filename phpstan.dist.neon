parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    scanDirectories:
        # The shipped example plugins live outside the analysed paths (src/, tests/), but the
        # test suite references their classes directly. scanDirectories lets phpstan discover
        # those symbols without analysing (and therefore without reporting on) the plugins.
        - plugins/utm-tagging/src
        - plugins/click-webhook/src
    excludePaths:
        # Generated by Symfony (config:dump-reference): it references *Config classes that
        # only exist inside the warmed var/cache/<env> tree, so analysing it fails on a
        # clean checkout while adding nothing.
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
        # Entities are bound to forms, which need nullable setters/properties for required relations.
        allowNullablePropertyForRequiredField: true
