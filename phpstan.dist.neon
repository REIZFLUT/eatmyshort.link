parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony (config:dump-reference): it references *Config classes that
        # only exist inside the warmed var/cache/<env> tree, so analysing it fails on a
        # clean checkout while adding nothing.
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
        # Entities are bound to forms, which need nullable setters/properties for required relations.
        allowNullablePropertyForRequiredField: true
