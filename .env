# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite-Datei ausserhalb von public/. Das Verzeichnis muss fuer den PHP-FPM-Nutzer beschreibbar sein
# (im WAL-Modus legt SQLite daneben -wal und -shm an).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/eatmyshort.sqlite"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###


###> eatmyshort ###
# Hostname(s) der Verwaltungsoberflaeche, kommagetrennt. Der erste ist der Haupt-Host
# (WebAuthn Relying Party ID, absolute Links in Mails). Alle anderen Hosts werden als
# Kurzlink-Domains behandelt.
APP_ADMIN_HOSTS=localhost
# Absender fuer Einladungen und Passwort-Links
MAILER_FROM="EatMyShort.Link <noreply@localhost>"
# Diese IPs/CIDRs duerfen /admin IMMER aufrufen (Schutz vor Aussperren), kommagetrennt.
ADMIN_IP_ALLOWLIST=
# Reverse-Proxys, denen X-Forwarded-For geglaubt wird (z. B. 127.0.0.1,REMOTE_ADDR). Leer = keine.
TRUSTED_PROXIES=
# Optional: Pfad zu einer GeoLite2-Country.mmdb fuer Laender in der Statistik
GEOIP_DATABASE_PATH=
# Zeitzone fuer Statistik (Klicks pro Tag) und Anzeige
APP_TIMEZONE=Europe/Berlin
# Klicks werden nach so vielen Tagen von app:clicks:prune geloescht (0 = nie)
CLICK_RETENTION_DAYS=730
###< eatmyshort ###
